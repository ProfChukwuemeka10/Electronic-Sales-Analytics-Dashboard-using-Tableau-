              <calculation class='tableau' formula='NOT ISNULL([Order Date])&#13;&#10;AND NOT ISNULL([Price Each])&#13;&#10;AND NOT ISNULL([Quantity Ordered])&#13;&#10;AND NOT ISNULL([Product])' />
            </column>
            <column caption='Sales' datatype='real' name='[Calculation_1262415308987424769]' role='measure' type='quantitative'>
