      </column>
      <column caption='City' datatype='string' name='[Calculation_1262415308987699202]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM(SPLIT([Purchase Address], &quot;,&quot;, 2))' />
      </column>
      <column caption='Selected Product Rank' datatype='integer' name='[Calculation_1262415308988342275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Top 10&quot; THEN&#13;&#10;    RANK_DENSE(SUM([Calculation_1262415308987424769]), &apos;desc&apos;)&#13;&#10;ELSE&#13;&#10;    RANK_DENSE(SUM([Calculation_1262415308987424769]), &apos;asc&apos;)&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_1262415308992622599]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected City Sales' datatype='real' name='[Calculation_1262415308998483983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Total Sales&quot; THEN SUM([Calculation_1262415308987424769])&#13;&#10;WHEN &quot;Average Sales&quot; THEN AVG([Calculation_1262415308987424769])&#13;&#10;END' />
      </column>
      <column caption='Warranty End Date' datatype='date' name='[Calculation_1262415309032558608]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, 6, [Order Date]))' />
      </column>
